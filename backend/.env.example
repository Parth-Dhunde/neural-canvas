APP_NAME=NeuralCanvas
HOST=0.0.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# Paths relative to the repository workspace root
JOBS_ROOT=jobs
DATASETS_ROOT=datasets
ENGINES_ROOT=engines
MODELS_ROOT=models
OUTPUTS_ROOT=outputs

# COLMAP binary on PATH or absolute path to the executable
COLMAP_BINARY=colmap
COLMAP_USE_GPU=false
COLMAP_CAMERA_MODEL=OPENCV
# Fail camera estimation when COLMAP registers fewer than this fraction of masked images (0.0-1.0)
COLMAP_MIN_REGISTRATION_RATIO=0.5

# Absolute path or path relative to the workspace root
INSTANT_NGP_ROOT=engines/instant-ngp
# Must match the Python version used to build pyngp (see engines/instant-ngp/build/).
# Prefer the backend virtualenv so commentjson and other runtime deps are available:
# INSTANT_NGP_PYTHON=/absolute/path/to/website/backend/.venv/bin/python
INSTANT_NGP_PYTHON=python3
INSTANT_NGP_N_STEPS=35000

# Mesh extraction (stage 5)
MESH_RESOLUTION=256
MESH_DENSITY_THRESHOLD=2.5

# Mesh cleanup (stage 6)
MESH_CLEANUP_TAUBIN_ITERATIONS=10
MESH_CLEANUP_TAUBIN_LAMBDA=0.33
MESH_CLEANUP_TAUBIN_NU=0.34
MESH_CLEANUP_SMOOTH_MIN_COMPONENT_FACES=60
MESH_CLEANUP_MIN_COMPONENT_FACES=12
MESH_CLEANUP_DECIMATE_MIN_FACES=50000
MESH_CLEANUP_DECIMATE_MAX_FACES=250000
